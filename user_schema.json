{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "users": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9]{20,}$": {
          "type": "object",
          "properties": {
            "birthdate": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp of the user's birthdate in ISO 8601 format"
            },
            "created_time": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp of when the user account was created"
            },
            "display_name": {
              "type": "string",
              "description": "User's display name"
            },
            "favoriteAnimal": {
              "type": "string",
              "description": "User's favorite animal"
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "User's email address"
            },
            "photo_url": {
              "type": "string",
              "format": "uri",
              "description": "URL to the user's profile picture"
            },
            "uid": {
              "type": "string",
              "description": "Unique identifier for the user"
            }
          },
          "required": ["birthdate", "created_time", "display_name", "email", "uid"]
        }
      }
    },
}
